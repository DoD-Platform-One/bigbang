{
    "baseBranchPatterns": [
        "master"
    ],
    "configWarningReuseIssue": false,
    "dependencyDashboard": true,
    "dependencyDashboardHeader": "- [ ] If there are Flux updates: Update your Flux CLI to the latest version possible based on available IB images. Note, if installing with homebrew on mac, use command `brew upgrade fluxcd/tap/flux`. This specific tap is needed to grab the latest version. Then from the root of the bigbang repository, run `flux install --components source-controller,kustomize-controller,helm-controller,notification-controller --export > base/flux/gotk-components.yaml` to generate the latest manifests",
    "dependencyDashboardTitle": "Renovate: Update Dependencies",
    "draftPR": true,
    "enabledManagers": [
        "helm-values",
        "custom.regex"
    ],
    "ignorePaths": [
        "**/templates/**/values.yaml"
    ],
    "labels": [
        "renovate",
        "kind::maintenance",
        "kind::Tools & Automation"
    ],
    "packageRules": [
        {
            "matchDatasources": [
                "docker"
            ],
            "groupName": "Ironbank",
            "registryUrls": [
                "https://registry1.dso.mil"
            ]
        },
        {
            "additionalBranchPrefix": "flux-",
            "addLabels": [
                "flux"
            ],
            "groupName": "Flux",
            "matchPackageNames": [
                "/flux/"
            ]
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "registry1.dso.mil/ironbank/opensource/postgres/postgresql"
            ],
            "allowedVersions": ">=17 <18"
        },
        {
            "matchManagers": [
                "custom.regex"
            ],
            "matchDatasources": [
                "git-tags"
            ],
            "matchPackageNames": [
                "https://repo1.dso.mil/big-bang/product/maintained/cloudnative-pg.git",
                "https://repo1.dso.mil/big-bang/product/maintained/garage.git",
                "https://repo1.dso.mil/big-bang/product/maintained/redis.git"
            ],
            "groupName": "GitLab CI Dependencies"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^base/flux/kustomization\\.yaml/"
            ],
            "matchStrings": [
                "newName\\S*:\\s*(?<depName>\\S+).*\n\\s+newTag:\\s*(?<currentValue>.+)"
            ],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^tests/images\\.txt$/"
            ],
            "matchStrings": [
                "s*(?<depName>.+):(?<currentValue>.+)"
            ],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^tests/extended/test-values-packages-key\\.yaml$/"
            ],
            "matchStrings": [
                "tag:\\s+[\\\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+-bb\\.\\d+)[\\\"']?"
            ],
            "depNameTemplate": "https://repo1.dso.mil/big-bang/product/maintained/podinfo.git",
            "datasourceTemplate": "git-tags",
            "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-bb\\.(?<build>\\d+)$"
        },
        {
            "customType": "regex",
            "description": "Update the PostgreSQL 17 image used by the GitLab CI operand",
            "managerFilePatterns": [
                "/^tests/test-values\\.yaml$/"
            ],
            "matchStrings": [
                "imageName:\\s+(?<depName>registry1\\.dso\\.mil/ironbank/opensource/postgres/postgresql):(?<currentValue>[^\\s\"']+)"
            ],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Update the Big Bang wrapper chart used by the GitLab CI PostgreSQL operand",
            "managerFilePatterns": [
                "/^tests/test-values\\.yaml$/"
            ],
            "matchStrings": [
                "chartName:\\s+wrapper\\s+tag:\\s+[\"']?(?<currentValue>[^\\s\"']+)"
            ],
            "depNameTemplate": "registry1.dso.mil/bigbang/wrapper",
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Update maintained GitLab CI dependencies",
            "managerFilePatterns": [
                "/^tests/(?:test-values(?:-ambient)?|oci-values)\\.yaml$/"
            ],
            "matchStrings": [
                "repo:\\s+https://repo1\\.dso\\.mil/big-bang/product/maintained/(?<maintainedPackage>cloudnative-pg|garage|redis)\\.git\\s+path:\\s+chart\\s+tag:\\s+[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
            ],
            "depNameTemplate": "https://repo1.dso.mil/big-bang/product/maintained/{{{maintainedPackage}}}.git",
            "datasourceTemplate": "git-tags",
            "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-bb\\.(?<build>\\d+)$"
        }
    ],
    "separateMajorMinor": false
}
